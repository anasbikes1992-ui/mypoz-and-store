# MyPoz & Store — environment variable names (no secrets)
# Copy to .env.local. Production values live on Vercel → mypoz-and-store-ui.
# Project: veavfkjgtkbnggukzjds · App: https://mypoz-and-store-ui.vercel.app

# ─── Required for production (Vercel) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=https://mypoz-and-store-ui.vercel.app
GMS_ADMIN_EMAILS=anasbikes1992@gmail.com

# Jarvis HQ agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── WhatsApp — use Meta app GRABBER (has WhatsApp product) ─────────────────
# Still need WHATSAPP_TOKEN even if phone / verify / app secret are set.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ─── Email ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=MyPoz <noreply@mypoz.lk>
RESEND_REPLY_TO=support@mypoz.lk

# ─── Payments (WebXPay staging first — live keys later) ─────────────────────
# Docs: https://developers.webxpay.com/Guides/Redirect-Integration/redirect.html
# Staging redirect: https://stagingxpay.info/index.php?route=checkout/billing
# Live redirect:    https://webxpay.com/index.php?route=checkout/billing
# Tokenize staging (unused by POS redirect): https://tokenize.stagingxpay.info/
# Dashboard Return URL: {NEXT_PUBLIC_APP_URL}/api/payments/webhook/WEBXPAY
PAYMENTS_LKR_PROVIDER=WEBXPAY
WEBXPAY_ENV=staging
WEBXPAY_PUBLIC_KEY=
WEBXPAY_SECRET_KEY=
# Optional: skip payment method picker (40 = Commercial Bank MPGS LKR)
# WEBXPAY_PAYMENT_GATEWAY_ID=40
# Optional override (defaults from WEBXPAY_ENV):
# WEBXPAY_GATEWAY_URL=https://stagingxpay.info/index.php?route=checkout/billing
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
MYPOS_BANK_INSTRUCTIONS=

# ─── Local / scripts ONLY — do not put passwords on Vercel ──────────────────
SUPABASE_PROJECT_REF=veavfkjgtkbnggukzjds
SUPABASE_DB_PASSWORD=
UPSERT_ADMIN_EMAIL=
UPSERT_ADMIN_PASSWORD=
UPSERT_ADMIN_NAME=
UPSERT_ORG_NAME=
UPSERT_ORG_SLUG=
POS_SESSION_SECRET=
POS_USER=
POS_PASSWORD=
POS_ALLOW_DEMO=false
GMS_ADMIN_USERS=
PRINTER_RECEIPT_IP=
PRINTER_KOT_IP=
PRINTER_BOT_IP=
PLAYWRIGHT_EMAIL=
PLAYWRIGHT_PASSWORD=

# ─── Distributed rate limit (Vercel multi-instance) ─────────────────────────
# Without these, proxy falls back to in-memory Maps (dev / single isolate only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
