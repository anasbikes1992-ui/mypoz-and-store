# MyPoz & Store — environment variable names (no secrets)
# Copy to .env.local and fill values from Supabase / Vercel dashboards.

# Supabase (project veavfkjgtkbnggukzjds)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (canonical production host)
NEXT_PUBLIC_APP_URL=

# Optional: direct SQL scripts (apply-sql.mjs, check-migrations.mjs)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Admin provisioning (scripts/upsert-admin.mjs)
UPSERT_ADMIN_EMAIL=
UPSERT_ADMIN_PASSWORD=
UPSERT_ADMIN_NAME=

# GMS HQ access
GMS_ADMIN_EMAILS=
GMS_ADMIN_USERS=

# WhatsApp Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Demo mode session (when Supabase not configured)
POS_SESSION_SECRET=
POS_USER=
POS_PASSWORD=

# Printers (optional)
PRINTER_RECEIPT_IP=
PRINTER_KOT_IP=
PRINTER_BOT_IP=
