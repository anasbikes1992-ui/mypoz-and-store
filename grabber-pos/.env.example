# MyPoz & Store — environment variable names (no secrets)
# Copy to .env.local. Production values live on Vercel → mypoz-and-store-ui.
# Project: veavfkjgtkbnggukzjds · App: https://mypoz-and-store-ui.vercel.app

# ─── Required for production (Vercel) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=https://mypoz-and-store-ui.vercel.app
GMS_ADMIN_EMAILS=anasbikes1992@gmail.com

# Jarvis HQ agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── WhatsApp — use Meta app GRABBER (has WhatsApp product) ─────────────────
# Still need WHATSAPP_TOKEN even if phone / verify / app secret are set.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ─── Email ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=MyPoz <noreply@mypoz.lk>
RESEND_REPLY_TO=support@mypoz.lk

# ─── Payments (optional at soft launch) ─────────────────────────────────────
PAYMENTS_LKR_PROVIDER=WEBXPAY
WEBXPAY_PUBLIC_KEY=
WEBXPAY_SECRET_KEY=
WEBXPAY_GATEWAY_URL=
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
MYPOS_BANK_INSTRUCTIONS=

# ─── Local / scripts ONLY — do not put passwords on Vercel ──────────────────
SUPABASE_PROJECT_REF=veavfkjgtkbnggukzjds
SUPABASE_DB_PASSWORD=
UPSERT_ADMIN_EMAIL=
UPSERT_ADMIN_PASSWORD=
UPSERT_ADMIN_NAME=
UPSERT_ORG_NAME=
UPSERT_ORG_SLUG=
POS_SESSION_SECRET=
POS_USER=
POS_PASSWORD=
POS_ALLOW_DEMO=false
GMS_ADMIN_USERS=
PRINTER_RECEIPT_IP=
PRINTER_KOT_IP=
PRINTER_BOT_IP=
PLAYWRIGHT_EMAIL=
PLAYWRIGHT_PASSWORD=
