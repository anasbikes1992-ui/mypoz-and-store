# MyPoz & Store — environment variable names (no secrets)
# Copy to .env.local. Production values live on Vercel → mypoz-and-store-ui.
# Project: veavfkjgtkbnggukzjds · App: https://mypoz-and-store-ui.vercel.app
#
# Vercel KEEP (Production as of 2026-08-26):
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#   NEXT_PUBLIC_APP_URL, GMS_ADMIN_EMAILS, OPENAI_API_KEY
#   WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_VERIFY_TOKEN, WHATSAPP_APP_SECRET
#   WEBXPAY_PUBLIC_KEY, WEBXPAY_SECRET_KEY, WEBXPAY_ENV=staging, PAYMENTS_LKR_PROVIDER=WEBXPAY
#   UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN, RESEND_API_KEY
# Vercel REMOVE (do not recreate): Secret_Key (wrong name; use WEBXPAY_SECRET_KEY only)

# ─── Required — Supabase + app ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=https://mypoz-and-store-ui.vercel.app
GMS_ADMIN_EMAILS=anasbikes1992@gmail.com

# ─── Jarvis HQ agent ────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── WhatsApp (Meta Cloud) ──────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
# Optional once domain verified:
# RESEND_FROM_EMAIL=MyPoz <noreply@mypoz.lk>
# RESEND_REPLY_TO=support@mypoz.lk

# ─── Payments — WebXPay Redirect (staging first) ────────────────────────────
# Docs: https://developers.webxpay.com/Guides/Redirect-Integration/redirect.html
# Staging POST: https://stagingxpay.info/index.php?route=checkout/billing
# Live POST:    https://webxpay.com/index.php?route=checkout/billing
# Dashboard Return URL: {NEXT_PUBLIC_APP_URL}/api/payments/webhook/WEBXPAY
# Do NOT use Tokenize API username/password here.
PAYMENTS_LKR_PROVIDER=WEBXPAY
WEBXPAY_ENV=staging
WEBXPAY_PUBLIC_KEY=
WEBXPAY_SECRET_KEY=
# Optional: skip gateway picker (40 = Commercial Bank MPGS LKR)
# WEBXPAY_PAYMENT_GATEWAY_ID=40
# Optional URL override (defaults from WEBXPAY_ENV):
# WEBXPAY_GATEWAY_URL=https://stagingxpay.info/index.php?route=checkout/billing

# ─── Alternate gateways (optional — not on Vercel for LKR cutover) ──────────
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_SANDBOX=true
# MYPOS_BANK_INSTRUCTIONS=

# ─── Distributed rate limit (Upstash) ───────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Local / scripts ONLY — never put on Vercel ─────────────────────────────
SUPABASE_PROJECT_REF=veavfkjgtkbnggukzjds
SUPABASE_DB_PASSWORD=
UPSERT_ADMIN_EMAIL=
UPSERT_ADMIN_PASSWORD=
UPSERT_ADMIN_NAME=
UPSERT_ORG_NAME=
UPSERT_ORG_SLUG=
POS_SESSION_SECRET=
POS_USER=
POS_PASSWORD=
POS_ALLOW_DEMO=false
# Production Vercel builds refuse missing Supabase keys unless POS_ALLOW_DEMO=true
# POS_SHOW_QUARANTINED_VERTICALS=true
GMS_ADMIN_USERS=
PRINTER_RECEIPT_IP=
PRINTER_KOT_IP=
PRINTER_BOT_IP=
PLAYWRIGHT_EMAIL=
PLAYWRIGHT_PASSWORD=
